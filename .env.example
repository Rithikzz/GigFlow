# ==========================================
# GigFlow - MERN SaaS Application Environment Configuration
# ==========================================
# This file provides a high-level reference for the environment setups
# needed for both the client (frontend) and server (backend) applications.

# ------------------------------------------
# BACKEND SERVICES (.env inside /server)
# ------------------------------------------
# Port the backend server will listen on
PORT=5000

# Node Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String
# - For Local Host: mongodb://localhost:27017/gigflow
# - For Docker Compose Setup: mongodb://mongodb:27017/gigflow
# - For Cloud (Atlas): mongodb+srv://<user>:<password>@cluster.mongodb.net/gigflow
MONGO_URI=mongodb://localhost:27017/gigflow

# JSON Web Token Secret Key for Authentication
JWT_SECRET=your_super_secret_jwt_hash_key_1357924680

# Allowed CORS Origin URL (the frontend web app url)
CLIENT_URL=http://localhost:3000

# ------------------------------------------
# FRONTEND SERVICES (.env inside /client)
# ------------------------------------------
# The base gateway endpoint pointing to the backend API
# - For Local Host: http://localhost:5000/api/v1
# - For Docker Compose Setup: http://localhost:5000/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1
